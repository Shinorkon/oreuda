# Oreuda Backend Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/oreuda

# JWT Authentication
SECRET_KEY=your-super-secret-jwt-key-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:8004,http://10.0.2.2:8004

# Optional: set to false in production
DEBUG=true
